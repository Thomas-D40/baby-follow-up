# Copy to .env on the VPS (never committed). Real values = GitHub Actions Secrets.
DOMAIN=suivi-baby.exemple.fr
GITHUB_OWNER=ton-compte-github
DB_USER=suivibaby
DB_PASSWORD=change-me-strong-secret

# --- Auth (Epic 1) ---
# Session cookie encryption key (>= 16 bytes, random). E.g.: openssl rand -base64 32
SESSION_ENC_KEY=change-me-random-32-bytes-minimum-secret

# First-admin bootstrap. The BCrypt hash is generated offline (never a plaintext password):
#   echo -n 'MyPassword' | htpasswd -niBC 12 '' | cut -d: -f2
ADMIN_EMAIL=admin@exemple.fr
ADMIN_FIRST_NAME=Admin
ADMIN_PASSWORD_HASH=$2a$12$replace-with-real-bcrypt-hash
